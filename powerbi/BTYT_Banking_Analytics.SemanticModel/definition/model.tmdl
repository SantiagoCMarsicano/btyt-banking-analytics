model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-419
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Bank Performance","Branch Performance","Campaign Performance","Customer Accounts","Market Performance","Credit Risk","Transactions and Channels","_Measures","Customer Monthly"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table 'Bank Performance'
ref table 'Branch Performance'
ref table 'Campaign Performance'
ref table 'Customer Accounts'
ref table 'Market Performance'
ref table 'Credit Risk'
ref table 'Transactions and Channels'
ref table DimDate
ref table _Measures
ref table 'Customer Monthly'
ref table 'Customer Ranking Metric'
ref table DimRelationshipDepth
ref table 'Portfolio Metric'
ref table 'DPD Exposure Selector'
ref table 'DPD Rate Switch'
ref table DimCustomerType
ref table 'Bridge Steps'
ref table 'Comparación temporal'

ref cultureInfo en-US

