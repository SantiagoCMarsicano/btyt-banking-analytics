	column 'Transaction Type Label' =
			
			SWITCH(
			    'Transactions and Channels'[transaction_type],
			    "TRANSFER_IN", "Transferencia recibida",
			    "TRANSFER_OUT", "Transferencia enviada",
			    "DEBIT_PURCHASE", "Compra con débito",
			    "SERVICE_PAYMENT", "Pago de servicios",
			    "CASH_WITHDRAWAL", "Retiro de efectivo",
			    "CASH_DEPOSIT", "Depósito de efectivo",
			    "LOAN_PAYMENT", "Pago de préstamo",
			    "INTEREST_CREDIT", "Crédito de intereses",
