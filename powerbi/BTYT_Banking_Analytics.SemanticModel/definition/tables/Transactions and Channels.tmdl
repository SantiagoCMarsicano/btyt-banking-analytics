	column 'Channel Label' =
			
			SWITCH(
			    'Transactions and Channels'[channel],
			    "MOBILE", "Móvil",
			    "WEB", "Web",
			    "BRANCH", "Sucursal",
			    "ATM", "Cajero automático",
			    "AUTOMATIC", "Automático",
			    "POS", "POS",
