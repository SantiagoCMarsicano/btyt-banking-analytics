	column 'Campaign Type ES' =
			
			SWITCH(
			    UPPER('Campaign Performance'[campaign_type]),
			    "ACTIVATION", "Activación",
			    "ACQUISITION", "Adquisición",
			    "RETENTION", "Retención",
			    "UPSELL", "Venta adicional",
			    "CROSS_SELL", "Venta cruzada",
			    'Campaign Performance'[campaign_type]
			)
		lineageTag: 1302fd80-05ee-4b57-811a-dd003c61ffba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Target Customer Type ES' =
			
			SWITCH(
			    UPPER('Campaign Performance'[target_customer_type]),
			    "INDIVIDUAL", "Personas",
			    "BUSINESS", "Empresas",
			    "BOTH", "Ambos",
			    'Campaign Performance'[target_customer_type]
			)
		lineageTag: 29581994-b745-4c0a-b19c-ab8dd02255c7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Target Product ES' =
			
			SWITCH(
			    TRUE(),
			
			    ISBLANK('Campaign Performance'[target_product_id]),
			        "Sin producto específico",
			
			    'Campaign Performance'[target_product_id] = "P001",
			        "Caja de ahorro UYU",
			
			    'Campaign Performance'[target_product_id] = "P005",
			        "Cuenta sueldo",
			
			    'Campaign Performance'[target_product_id] = "P006",
			        "Cuenta joven / estudiante",
			
			    'Campaign Performance'[target_product_id] = "P008",
