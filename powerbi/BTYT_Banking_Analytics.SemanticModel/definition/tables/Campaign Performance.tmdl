			    'Campaign Performance'[target_product_id] = "P011",
			        "Tarjeta de crédito premium",
			
			    'Campaign Performance'[target_product_id] = "P013",
			        "Préstamo automotor",
			
			    'Campaign Performance'[target_product_id] = "P014",
			        "Préstamo hipotecario",
			
			    'Campaign Performance'[target_product_id] = "P015",
			        "Préstamo PyME",
			
			    'Campaign Performance'[target_product_id] = "P016",
			        "Línea de crédito empresarial",
			
			    'Campaign Performance'[target_product_id] = "P017",
			        "Préstamo agropecuario",
			
			    'Campaign Performance'[target_product_id] = "P018",
			        "Leasing empresarial",
			
			    'Campaign Performance'[target_product_id]
			)
		lineageTag: 7ef2b9b5-5397-461d-b232-b8bcb28f4a23
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

