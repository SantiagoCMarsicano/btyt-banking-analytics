	column 'Loan Type' =
			
			SWITCH (
			    'Credit Risk'[product_id],
			    "P012", "Préstamo personal",
			    "P013", "Préstamo automotor",
			    "P014", "Préstamo hipotecario",
			    "P015", "Préstamo PyME",
			    "P016", "Línea de crédito empresarial",
			    "P017", "Préstamo agropecuario",
			    "P018", "Leasing empresarial",
			    "Otro"
			)
		lineageTag: 1d27fb9c-7add-4c10-b70e-8f87ef640535
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column loan_statuses =
			
			SWITCH (
			    'Credit Risk'[loan_status],
			    "ACTIVE", "Activo",
			    "DEFAULTED", "En incumplimiento",
			    "PAID_OFF", "Cancelado",
			    "RESTRUCTURED", "Reestructurado",
			    "WRITTEN_OFF", "Dado de baja",
			    "Otro"
			)
		lineageTag: c4bcd86d-c180-4bed-9d0f-f7ca51e3677c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Delinquency Status Label' =
			
			SWITCH(
			    'Credit Risk'[delinquency_status],
			    "CURRENT", "Al día",
			    "DPD_1_30", "1–30 días",
			    "DPD_31_60", "31–60 días",
			    "DPD_61_90", "61–90 días",
			    "DPD_90_PLUS", "Más de 90 días",
			    "Otro"
			)
		lineageTag: 57fd6e3f-f13f-47d5-9dbb-c3e3645c44de
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

