	column 'Residence Department' =
			
			IF(
			    ISBLANK('Customer Accounts'[residence_department])
			        || TRIM('Customer Accounts'[residence_department]) = "",
			    "Extranjeros",
			    'Customer Accounts'[residence_department]
			)
		lineageTag: 08e3df66-2773-4193-bec2-a66f72212f96
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

