		summarizeBy: sum
		sourceColumn: active_accounts_all

		annotation SummarizationSetBy = Automatic

	column 'Customer Segment' =
			
			SWITCH(
			    TRUE(),
			
			    'Customer Accounts'[customer_type] = "INDIVIDUAL"
			        && 'Customer Accounts'[employment_status] = "EMPLOYED", "Empleado",
			
			    'Customer Accounts'[customer_type] = "INDIVIDUAL"
			        && 'Customer Accounts'[employment_status] = "SELF_EMPLOYED", "Independiente",
			
			    'Customer Accounts'[customer_type] = "INDIVIDUAL"
			        && 'Customer Accounts'[employment_status] = "STUDENT", "Estudiante",
			
			    'Customer Accounts'[customer_type] = "INDIVIDUAL"
			        && 'Customer Accounts'[employment_status] = "RETIRED", "Jubilado",
			
			    'Customer Accounts'[customer_type] = "INDIVIDUAL"
			        && 'Customer Accounts'[employment_status] = "UNEMPLOYED", "Desempleado",
			
			    'Customer Accounts'[customer_type] = "INDIVIDUAL", "Otros individuos",
			
			    'Customer Accounts'[customer_type] = "BUSINESS"
			        && 'Customer Accounts'[company_size] = "MICRO", "Microempresa",
			
			    'Customer Accounts'[customer_type] = "BUSINESS"
			        && 'Customer Accounts'[company_size] = "SMALL", "Empresa pequeña",
			
			    'Customer Accounts'[customer_type] = "BUSINESS"
			        && 'Customer Accounts'[company_size] = "MEDIUM", "Empresa mediana",
			
			    'Customer Accounts'[customer_type] = "BUSINESS"
			        && 'Customer Accounts'[company_size] = "LARGE", "Empresa grande",
			
			    "Otro"
			)
		lineageTag: c9c2b0e6-643d-4c60-887e-b68a2be7b1be
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Etiqueta para rankings: razón social para empresas, 'Cliente' + ID para personas.
	column 'Customer Display' =
			
			IF(
			    'Customer Accounts'[customer_type] = "BUSINESS",
			    'Customer Accounts'[customer_name],
			    "Cliente " & 'Customer Accounts'[customer_id]
			)
		lineageTag: 3d0ecc8c-091c-481d-9630-cb947794c7bd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

