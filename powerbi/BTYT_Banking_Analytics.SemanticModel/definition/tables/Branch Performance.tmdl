		annotation SummarizationSetBy = Automatic

	column 'Region ES' =
			
			SWITCH(
			    'Branch Performance'[region],
			    "CENTRAL", "Centro",
			    "EAST", "Este",
			    "LITTORAL", "Litoral",
			    "METROPOLITAN", "Metropolitana",
