	column 'Branch Size ES' =
			
			SWITCH(
			    'Branch Performance'[branch_size],
			    "LARGE", "Grande",
			    "MEDIUM", "Mediana",
			    "SMALL", "Pequeña",
			    'Branch Performance'[branch_size]
			)
		lineageTag: 4835ad28-93f2-4d5e-b267-4cd12ddc5eb1
