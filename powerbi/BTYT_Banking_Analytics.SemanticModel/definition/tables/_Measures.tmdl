table _Measures
	lineageTag: 24914dcb-a6b0-40de-aef1-f314359406c4

	/// Ingresos totales del banco (margen financiero + comisiones) en USD, al tipo de cambio de cada año.
	measure 'Total Revenue' =
			
			SUMX(
			    'Bank Performance',
			    DIVIDE(
			        'Bank Performance'[total_revenue],
			        RELATED('DimDate'[UYU per USD])
			    )
			)
		formatString: "US$"#,0;-"US$"#,0;"US$"#,0
		displayFolder: Resultados
		lineageTag: d6ba5c23-b9d4-4394-a64f-2d2221e33286

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-FM"}

	/// Resultado neto del banco en USD, al tipo de cambio de cada año.
	measure 'Net Income' =
			
			SUMX(
			    'Bank Performance',
			    DIVIDE(
			        'Bank Performance'[net_income],
			        RELATED('DimDate'[UYU per USD])
			    )
			)
		formatString: "US$"#,0.00;-"US$"#,0.00;"US$"#,0.00
		displayFolder: Resultados
		lineageTag: 4d0547ae-f749-48c7-9d32-e81921239bcf

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-FM"}

	/// Resultado neto sobre ingresos totales.
	measure 'Net Margin' =
			
			DIVIDE(
			    [Net Income],
			    [Total Revenue]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Resultados
		lineageTag: 861f9b48-f56d-4521-9e1a-2bf9bfd56987

		changedProperty = IsHidden

	/// Costos operativos totales del banco en USD.
	measure 'Total Operating Cost' =
			
			SUMX(
			    'Bank Performance',
			    DIVIDE(
			        'Bank Performance'[total_operating_cost],
			        RELATED('DimDate'[UYU per USD])
			    )
			)
		displayFolder: Costos
		lineageTag: 418eca80-8cfe-438d-bd5f-ccc9d4adeda6

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Costos operativos totales sobre ingresos totales. Más bajo es mejor.
	measure Cost-to-Income =
			
			DIVIDE(
			    [Total Operating Cost],
			    [Total Revenue]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Resultados
		lineageTag: e2c9a671-925f-4fea-b17b-982484d84ea7

		changedProperty = IsHidden

