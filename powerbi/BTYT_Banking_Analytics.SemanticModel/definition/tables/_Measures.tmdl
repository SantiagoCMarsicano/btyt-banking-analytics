	/// Clientes que cerraron su relación en el año seleccionado.
	measure 'Closed Customers' =
			
			VAR SelectedYear =
			    MAX('DimDate'[Year])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Customer Accounts'[customer_id]),
			    FILTER(
			        ALL('Customer Accounts'[closing_year]),
			        'Customer Accounts'[closing_year] = SelectedYear
			    )
			)
		formatString: 0
		displayFolder: Clientes y cartera
		lineageTag: d9246861-e5b8-4834-ab88-137325f1dc1b

		changedProperty = IsHidden

