	/// Exposición promedio mensual con 30 o más días de atraso, en USD.
	measure '30+ DPD Exposure' =
			
			AVERAGEX(
			    VALUES('DimDate'[YearMonth]),
			    CALCULATE(
			        SUMX(
			            'Credit Risk',
			            VAR FX =
			                RELATED('DimDate'[UYU per USD])
			            RETURN
			                IF(
			                    'Credit Risk'[currency] = "USD",
			                    'Credit Risk'[outstanding_balance],
			                    DIVIDE('Credit Risk'[outstanding_balance], FX)
			                )
			        ),
			        KEEPFILTERS('Credit Risk'[days_past_due] >= 30)
			    )
			)
		formatString: "US$"#,0;-"US$"#,0;"US$"#,0
		displayFolder: Riesgo de crédito
		lineageTag: bb459da2-9db1-46c8-821f-ec660bd5ff99

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-IO"}

	/// Exposición con 30+ días de atraso sobre la exposición total.
	measure '30+ DPD Exposure Rate' =
			
			VAR Monthly30PlusExposure =
			    AVERAGEX(
			        VALUES('DimDate'[YearMonth]),
			        CALCULATE(
			            SUMX(
			                'Credit Risk',
			                VAR FX =
			                    RELATED('DimDate'[UYU per USD])
			                RETURN
			                    IF(
			                        'Credit Risk'[currency] = "UYU",
			                        DIVIDE('Credit Risk'[outstanding_balance], FX),
			                        'Credit Risk'[outstanding_balance]
			                    )
			            ),
			            KEEPFILTERS('Credit Risk'[days_past_due] >= 30)
			        )
			    )
			
			VAR MonthlyTotalExposure =
			    AVERAGEX(
			        VALUES('DimDate'[YearMonth]),
			        CALCULATE(
			            SUMX(
			                'Credit Risk',
			                VAR FX =
			                    RELATED('DimDate'[UYU per USD])
			                RETURN
			                    IF(
			                        'Credit Risk'[currency] = "UYU",
			                        DIVIDE('Credit Risk'[outstanding_balance], FX),
			                        'Credit Risk'[outstanding_balance]
			                    )
			            )
			        )
			    )
			
			RETURN
			    DIVIDE(Monthly30PlusExposure, MonthlyTotalExposure)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Riesgo de crédito
		lineageTag: cf9048da-8aca-4f17-adeb-44ed5ae7aff0

		changedProperty = IsHidden

