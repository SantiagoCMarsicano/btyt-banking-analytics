	column 'Bank Type ES' =
			
			SWITCH(
			    UPPER('Market Performance'[bank_type]),
			    "COMMERCIAL_BANK", "Banco comercial",
			    "CORPORATE_BANK", "Banco corporativo",
			    "MORTGAGE_BANK", "Banco hipotecario",
			    "PRIVATE_BANK", "Banco privado",
			    "PUBLIC_BANK", "Banco público",
			    "INTERNAL", "BTYT",
			    'Market Performance'[bank_type]
			)
		lineageTag: bb1f421a-0145-41ee-930f-756e6db483a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Bank Name Group' =
			
			SWITCH(
			    TRUE(),
			    'Market Performance'[bank_name] IN {
			        "BHU",
			        "BTG Pactual Uruguay",
			        "Bandes",
			        "Banque Heritage Uruguay"
			    }, "Otros",
			    'Market Performance'[bank_name]
			)
		lineageTag: d1dc6f49-de4f-49cf-9d7e-89f96c3e6d4f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Fecha de cierre del año (31/12) para relacionar la cuota anual con DimDate.
	column 'Year Date' = DATE('Market Performance'[year], 12, 31)
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 7aeec21e-99b3-404f-a37c-ebcb5613d88a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Market Performance' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost:5432", "BTYT"),
				  #"Navigation 1" = Source{[Schema = "analytics", Item = "market_performance_yearly"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

